# KIRII mail SMTP (copy to .env.local and fill in values)
SMTP_HOST=mail.kirii.com.hk
SMTP_PORT=587
SMTP_USER=your-email@kirii.com.hk
SMTP_PASS=your-mailbox-password
# Display name only is OK — actual mailbox comes from SMTP_USER
SMTP_FROM=KIRII Portfolio

# Alternative (SSL): ns89.hostingspeed.net port 465
# SMTP_HOST=ns89.hostingspeed.net
# SMTP_PORT=465
# SMTP_SECURE=true
